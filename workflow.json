000000000006","name":"Gemini - Embedding Consulta","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[900,340],"parameters":{"method":"POST","url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-goog-api-key","value":"YOUR_GEMINI_API_KEY_HERE"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({ content: { parts: [{ text: $json.text }] } }) }}","options":{}}},{"id":"bbb00002-0002-0002-0002-000000000007","name":"Buscar en Supabase","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1120,340],"alwaysOutputData":true,"parameters":{"method":"POST","url":"https://YOUR_PROJECT_REF.supabase.co/rest/v1/rpc/match_documents","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"YOUR_SUPABASE_ANON_KEY_HERE"},{"name":"Authorization","value":"Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({ query_embedding: $json.embedding.values, match_threshold: 0.65, match_count: 5 }) }}","options":{}}},{"id":"bbb00002-0002-0002-0002-000000000008","name":"Construir Contexto","type":"n8n-nodes-base.code","typeVersion":2,"position":[1340,340],"parameters":{"jsCode":"const userText = $('Validar Mensaje').item.json.text;\nconst username = $('Validar Mensaje').item.json.username;\nconst chatId = $('Validar Mensaje').item.json.chatId;\n\nlet results;\nif (Array.isArray($json)) {\n  results = $json;\n} else {\n  results = $input.all().map(function(i) { return i.json; });\n}\n\nconst relevant = results.filter(function(r) { return r && r.content && r.similarity >= 0.65; });\n\nlet contextBlock = '';\nif (relevant.length > 0) {\n  contextBlock = relevant.map(function(r) {\n    return '[' + (r.metadata && r.metadata.source ? r.metadata.source : 'Curso') + ']\\n' + r.content;\n  }).join('\\n\\n---\\n\\n');\n}\n\nconst systemPrompt = [\n  'Sos un profesor con años de experiencia en el Curso Inverter. Respondés como si estuvieras hablando directamente con un alumno: de forma directa, clara, amable y pedagógica.',\n  '',\n  'REGLAS:',\n  '1. Si el mensaje es un saludo, despedida o conversación casual, respondé naturalmente y con cordialidad.',\n  '2. Para cualquier pregunta técnica o sobre el curso, usá ÚNICAMENTE la información del CONTEXTO que se te da abajo. Nunca uses conocimiento externo.',\n  '3. Dá la información de forma directa, sin frases como \"según el curso\", \"de acuerdo al material\", \"según la información disponible\" — simplemente explicá como lo haría un profesor.',\n  '4. Si la pregunta no está en el contexto, respondé EXACTAMENTE: \"No cuento con esa información, pero podés comunicarte al 4635 2181 de 9 a 12 hs donde uno de nuestros profesores va a estar disponible para responder todas tus dudas!\"',\n  '5. Nunca menciones que sos una IA o que tenés un contexto o base de datos.',\n  '',\n  'CONTEXTO DEL CURSO:',\n  contextBlock || '(sin contexto relevante)'\n].join('\\n');\n\nreturn [{ json: { systemPrompt: systemPrompt, userText: userText, username: username, chatId: chatId } }];"}},{"id":"bbb00002-0002-0002-0002-000000000009","name":"Gemini Chat","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1560,340],"parameters":{"method":"POST","url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-goog-api-key","value":"YOUR_GEMINI_API_KEY_HERE"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({ system_instruction: { parts: [{ text: $json.systemPrompt }] }, contents: [{ role: 'user', parts: [{ text: $json.userText }] }], gen